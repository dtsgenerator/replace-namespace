{
  "name": "@dtsgenerator/replace-namespace",
  "version": "2.0.0",
  "description": "replace the namespace names",
  "main": "index.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf index.js test/**/*.js *.tsbuildinfo",
    "format": "prettier --check 'index.ts' 'test/*.ts'",
    "format:fix": "prettier --write 'index.ts' 'test/*.ts'",
    "lint": "eslint --report-unused-disable-directives *.ts **/*.ts",
    "lint:fix": "eslint --fix --report-unused-disable-directives *.ts **/*.ts",
    "fix": "npm run format:fix && npm run lint:fix",
    "compile": "tsc -p .",
    "build": "npm run format && npm run lint && npm run compile",
    "do-test": "cross-env TS_NODE_FILES=true mocha --exit --require ts-node/register --colors test/*_test.ts",
    "test": "nyc npm run do-test",
    "coverage": "nyc report --reporter=lcov",
    "test:update-snapshot": "UPDATE_SNAPSHOT=1 npm run do-test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dtsgenerator/replace-namespace.git"
  },
  "keywords": [
    "dtsgenerator",
    "dtsgenerator-plugin"
  ],
  "author": "Horiuchi Hiroki <horiuchi.g@gmail.com> (https://github.com/horiuchi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dtsgenerator/replace-namespace/issues"
  },
  "homepage": "https://github.com/dtsgenerator/replace-namespace#readme",
  "devDependencies": {
    "@dtsgenerator/eslint-config": "^1.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.20.1",
    "cross-env": "^10.1.0",
    "dtsgenerator": "^4.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "dtsgenerator": "^4.0.0",
    "tslib": "^2.6.3"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
